# OddMaki Protocol - Environment Configuration
#
# Usage:
#   1. Copy this file: cp env.example .env
#   2. Edit .env with your values
#   3. Load before deploying: set -a; source .env; set +a
#
# Note: Do NOT use 'export' keyword in .env file

# =============================================================================
# REQUIRED
# =============================================================================

# RPC endpoint for your target network
RPC_URL=https://sepolia.base.org
# Options:
#   https://sepolia.base.org       (Base Sepolia testnet)
#   https://mainnet.base.org        (Base mainnet)
#   http://localhost:8545           (Local Anvil)

# =============================================================================
# OPTIONAL
# =============================================================================

# Etherscan API key for contract verification
# Get from: https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# ConditionalTokens contract address (set after Step 1 deployment)
# Base Sepolia 0x7364747372Ac4a175B5326f5B2C9CB1C271d32e8
CTF_ADDRESS=

# UMA Optimistic Oracle V3 address
# Find at: https://docs.uma.xyz/resources/network-addresses
# Base Sepolia 0x0F7fC5E6482f096380db6158f978167b57388deE
UMA_ORACLE_ADDRESS=

# Protocol treasury address (defaults to deployer if empty)
PROTOCOL_TREASURY=

# Pyth contract address
# Base Sepolia 0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
PYTH_ADDRESS=

# =============================================================================
# TESTNET TOKENS (Use existing tokens, don't deploy mocks)
# =============================================================================

# Base Sepolia Test USDC (get from faucet: https://faucet.circle.com/)
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Note: The deployment script only deploys MockERC20 tokens for local Anvil (chainId 31337)
# For testnets and mainnet, use existing token contracts
